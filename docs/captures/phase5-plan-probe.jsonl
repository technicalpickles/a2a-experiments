{"event": "artifact_update", "artifact_update": {"task_id": "b129df2e-dea6-44ce-978d-5b36ad00e6d2", "context_id": "c470982f-5c0c-4baf-8074-dd13759c8b66", "artifact": {"artifact_id": "6b57dd3f-9225-46e3-a5cb-d5a78d68db5b", "name": "test_app.py", "parts": [{"text": "--- a/test_app.py\n+++ b/test_app.py\n@@ -0,0 +1,36 @@\n+import copy\n+\n+import pytest\n+\n+from app import ITEMS, app\n+\n+\n+@pytest.fixture\n+def client():\n+    # ITEMS is module-level mutable state, so snapshot and restore it\n+    # around each test to keep tests independent.\n+    original = copy.deepcopy(ITEMS)\n+    app.config[\"TESTING\"] = True\n+    with app.test_client() as test_client:\n+        yield test_client\n+    ITEMS[:] = original\n+\n+\n+def test_delete_unknown_item_returns_404(client):\n+    unknown_id = max((item[\"id\"] for item in ITEMS), default=0) + 1\n+\n+    response = client.delete(f\"/items/{unknown_id}\")\n+\n+    assert response.status_code == 404\n+    assert response.get_json() == {\"error\": \"not found\"}\n+\n+\n+@pytest.mark.parametrize(\"payload\", [{}, {\"name\": \"\"}, {\"name\": \"   \"}])\n+def test_post_item_without_name_returns_400(client, payload):\n+    before = len(ITEMS)\n+\n+    response = client.post(\"/items\", json=payload)\n+\n+    assert response.status_code == 400\n+    assert response.get_json() == {\"error\": \"name is required\"}\n+    assert len(ITEMS) == before\n", "media_type": "text/x-diff"}]}}}
