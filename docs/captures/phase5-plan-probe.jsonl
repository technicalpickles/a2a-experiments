{"event": "artifact_update", "artifact_update": {"task_id": "b129df2e-dea6-44ce-978d-5b36ad00e6d2", "context_id": "c470982f-5c0c-4baf-8074-dd13759c8b66", "artifact": {"artifact_id": "02aff3f1-b75e-4d15-b43d-6f49e549afe5", "name": "app.py", "parts": [{"text": "--- a/app.py\n+++ b/app.py\n@@ -1 +1,17 @@\n+@app.post(\"/items\")\n+def create_item():\n+    payload = request.get_json(silent=True) or {}\n+    name = payload.get(\"name\")\n+    if not isinstance(name, str) or not name.strip():\n+        return jsonify({\"error\": \"name is required\"}), 400\n+\n+    item = {\n+        \"id\": max((i[\"id\"] for i in ITEMS), default=0) + 1,\n+        \"name\": name.strip(),\n+        \"price\": payload.get(\"price\"),\n+    }\n+    ITEMS.append(item)\n+    return jsonify(item), 201\n+\n+\n @app.delete(\"/items/<int:item_id>\")\n", "media_type": "text/x-diff"}]}}}
